{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.cts",
    "apps/desktop/src/shared/**/*.ts",
    "tests/escape/**/*.ts",
    "vitest.config.ts"
  ]
}
